# Turso Database Configuration
# Get these values from Turso dashboard: https://turso.tech/dashboard
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Environment
# development: Uses Turso cloud database (required for Cloudflare Workers)
# production: Uses Turso cloud database
ENVIRONMENT=development

# IMPORTANT: Cloudflare Workers does NOT support the file: protocol
# You must use Turso cloud database for both development and production
